from customtkinter import *

def click_boton_calcular():
    cantidad_dolares = entrada_dolares.get()
    try:
        cantidad_dolares = float(cantidad_dolares)
        cantidad_quetzales = cantidad_dolares * CAMBIO_QUETZALES
        cantidad_pesos = cantidad_dolares * CAMBIO_PESOS
        cantidad_euros = cantidad_dolares * CAMBIO_EUROS
        
        
        etiqueta_cantidad_quetzales.configure(text=f"Q{cantidad_quetzales:,.2f}")
        etiqueta_cantidad_pesos.configure(text=f"${cantidad_pesos:,.2f}")
        etiqueta_cantidad_Euros.configure(text=f"€{cantidad_euros:,.2f}")
        etiqueta_error.configure(text="Conversion Exitosa", fg_color=COLOR_VERDE)
    
    except ValueError:
        print("ERROR: La cantidad ingresada no es valida", fg_color=COLOR_ROJO)
        return
    
def click_boton_limpiar():
        entrada_dolares.delete(0, "end")
        etiqueta_cantidad_quetzales.configure(text="Q0.00")
        etiqueta_cantidad_pesos.configure(text="$0.00")
        etiqueta_cantidad_Euros.configure(text="€0.00")
        etiqueta_error.configure(text="GOOD MACHINE", fg_color=COLOR_ASENTO_1)




