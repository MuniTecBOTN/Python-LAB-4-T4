import numpy as np
import cv2 as cv 

imagen = np.array([
    [255,  255, 255],
    [255, 0, 255],
    [255, 255, 255]
], dtype=np.uint8)

print(imagen.shape)     # (3,3)
print(imagen[0, 0])     #0  esquina sup. izq
print(imagen[1,2])      #255 fila1, col.2

imagen_grande = cv.resize(imagen,(300, 300), interpolation=cv.INTER_LINEAR)

cv.imshow("Imagen ampliada", imagen_grande)




cv.waitKey(0)

      